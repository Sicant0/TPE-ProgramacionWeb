package views

import (
	"fmt"
	db "proyectoweb/db/sqlc"
)

// GastoList lista todos los gastos, permite editar o eliminar gastos
templ GastoList(gastos []db.Gasto) {
	<ul class="list" id="gasto-list" data-empty="Todavia no hay gastos cargados.">
		for _, g := range gastos {
			@GastoItem(g)
		}
	</ul>
}

// GastoItem lista el item de la lista de Gastos: el gasto con el boton de edicion y eliminacion (el de edicion ahora permite edicion in-place)
templ GastoItem(g db.Gasto){
<li class="list-item">
		<div class="item-main">
			<span class="item-title">{ g.Titulo }</span>
			<span class="item-sub">{ g.Descripcion }</span>
			<span class="item-meta">
				{ g.Fecha.Format("02/01/2006") } · Usuario #{ fmt.Sprint(g.IDUser) }
			</span>
		</div>
		<span class="tag">{ string(g.Categoria) }</span>
		<span class="amount">$ { g.Monto }</span>
		<div class="item-actions">
			<button
				type="button"
				class="btn btn-secondary"
				hx-get={ fmt.Sprintf("/gastos/%d/editar", g.IDGasto) }
				hx-target="closest li"
				hx-swap="outerHTML"
			>Editar</button>
			<button
				type="button"
				class="btn btn-danger"
				hx-delete={ fmt.Sprintf("/gastos/%d", g.IDGasto) }
				hx-target="closest li"
				hx-swap="outerHTML"
				hx-confirm="¿Borrar este gasto?"
			>Borrar</button>
		</div>
	</li>
}

// GastoEditItem es el item de un usuario que se renderiza al clickear el boton de edicion, mostrando un form para editar el gasto
templ GastoEditItem(f GastoFormData){
	<li class="list-item">
		@GastoForm(f, nil)
	</li>
}

// Pagina de gastos que utiliza la GastoList: ahora incluye tambien el formulario arriba para crear gastos para realizar recarga parcial via HTMX
templ GastosPage(gastos []db.Gasto, form GastoFormData, usuarios []db.Usuario) {
	@Layout("Gastos") {
		<section class="panel">
			<h1>Crear gasto</h1>
			if len(usuarios) == 0 {
				<p class="empty">Para cargar un gasto primero tiene que existir un usuario.</p>
				<a class="btn" href="/usuarios">Crear Usuario</a>
			} else {
				@GastoCreateDivForm(form, usuarios)
			}
		</section>
		<section class="panel">
			<h1>Gastos</h1>
			@GastoList(gastos)
		</section>
	}
}

//Div utilizado para envolver el formulario para poder utilizar OOB mas adelante
templ GastoCreateDivForm(f GastoFormData, usuarios []db.Usuario){
	<div id="gasto-form">
		@GastoForm(f, usuarios)
	</div>
}

// Div igual en contenido que GastoCreateDivForm pero utilizado con OOB para limpiarse al mismo tiempo cuando se crea un gasto y se realiza recarga parcial de los nuevos gastos
templ GastoCreateDivFormOOB(f GastoFormData, usuarios []db.Usuario){
	<div id="gasto-form" hx-swap-oob="true">
		@GastoForm(f, usuarios)
	</div>
}

// GastoForm se utiliza tanto para crear un gasto como para editar un gasto
templ GastoForm(f GastoFormData, usuarios []db.Usuario) {
	<form
		class="form"
		method="post"
		action={ gastoFormAction(f) }
		if f.ID == 0 {
			hx-post="/gastos"
			hx-target="#gasto-list"
			hx-swap="outerHTML"
			hx-target-error="#gasto-form"
		} else {
			hx-post={ fmt.Sprintf("/gastos/%d/editar", f.ID) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-target-error="closest li"
		}
	>
		if f.Error != "" {
			<p class="alert">{ f.Error }</p>
		}
		if f.ID == 0 {
			<label for="id_user">Usuario</label>
			<select id="id_user" name="id_user" required>
				<option value="">Elegí un usuario</option>
				for _, u := range usuarios {
					<option value={ fmt.Sprint(u.IDUser) } selected?={ u.IDUser == f.IDUser }>{ u.Username }</option>
				}
			</select>
		} else {
			<label for={ campoID("id_user", f.ID) }>ID de usuario</label>
			<input type="hidden" name="id_user" value={ fmt.Sprint(f.IDUser) }/>
			<input id={ campoID("id_user", f.ID) } type="text" value={ fmt.Sprint(f.IDUser) } disabled/>
		}
		<label for={ campoID("titulo", f.ID) }>Título</label>
		<input id={ campoID("titulo", f.ID) } name="titulo" type="text" value={ f.Titulo } maxlength="15" required/>
		<label for={ campoID("descripcion", f.ID) }>Descripción</label>
		<textarea id={ campoID("descripcion", f.ID) } name="descripcion" maxlength="255" rows="3" required>{ f.Descripcion }</textarea>
		<div class="form-row">
			<div class="field">
				<label for={ campoID("monto", f.ID) }>Monto</label>
				<input id={ campoID("monto", f.ID) } name="monto" type="number" step="0.01" min="0.01" value={ f.Monto } required/>
			</div>
			<div class="field">
				<label for={ campoID("fecha", f.ID) }>Fecha</label>
				<input id={ campoID("fecha", f.ID) } name="fecha" type="date" value={ f.Fecha } required/>
			</div>
		</div>
		<label for={ campoID("categoria", f.ID) }>Categoría</label>
		<select id={ campoID("categoria", f.ID) } name="categoria" required>
			<option value="">Elegí una categoría</option>
			for _, c := range Categorias {
				<option value={ c } selected?={ c == f.Categoria }>{ c }</option>
			}
		</select>
		<div class="form-actions">
			if f.ID == 0 {
				<button type="submit" class="btn">Crear gasto</button>
			} else {
				<button
					type="button"
					class="btn btn-secondary"
					hx-get={ fmt.Sprintf("/gastos/%d", f.ID) }
					hx-target="closest li"
					hx-swap="outerHTML"
				>Cancelar</button>
				<button type="submit" class="btn">Guardar cambios</button>
			}
		</div>
	</form>
}

// gastoFormAction devuelve la URL a la que el formulario hace POST:
// /gastos para crear (ID == 0) o /gastos/{id}/editar para actualizar.
func gastoFormAction(f GastoFormData) templ.SafeURL {
	if f.ID == 0 {
		return templ.URL("/gastos")
	}
	return templ.URL(fmt.Sprintf("/gastos/%d/editar", f.ID))
}