package views

templ IndexPage() {
	@Layout("Inicio") {
		<section class="panel">
			<h1>Administrador de Gastos</h1>
			<p class="muted">
				Registrá usuarios y sus gastos, categorizalos y llevá un control de en qué se va el dinero.
				Usá el menú de arriba para crear o listar usuarios y gastos.
			</p>
		</section>
	}
}
