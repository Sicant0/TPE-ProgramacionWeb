package views

// Layout principal de la pagina
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - Administrador de Gastos</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			// extension oficial para poder redirigir segun codigo de respuesta (hx-target-error)
			<script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/response-targets.js"></script>
		</head>
		<body hx-ext="response-targets">
			<header class="site-header">
				<a class="brand" href="/">Administrador de Gastos</a>
				<nav class="nav">
					<a href="/usuarios">Usuarios</a>
					<a href="/gastos">Gastos</a>
				</nav>
			</header>
			<main class="site-content">
				{ children... }
			</main>
			<footer class="site-footer">
				<p>TPE Programación Web</p>
			</footer>
		</body>
	</html>
}
