package views

import (
	"fmt"
	db "proyectoweb/db/sqlc"
)

// UserList lista todos los usuarios y sus datos, y permite editar y eliminar cada uno
templ UserList(usuarios []db.Usuario) {
	<ul class="list" id="user-list" data-empty="Todavia no hay usuarios cargados.">
		for _, u := range usuarios {
			@UserItem(u)
		}
	</ul>
}

// UserItem lista el item de la lista de Usuarios: el usuario con el boton de edicion y eliminacion (el de edicion ahora permite edicion in-place)
templ UserItem(u db.Usuario) {
	<li class="list-item">
		<div class="item-main">
			<span class="item-title">{ u.Username }</span>
			<span class="item-sub">{ u.Email }</span>
		</div>
		<span class="tag">#{ fmt.Sprint(u.IDUser) }</span>
		<div class="item-actions">
			<button
				type="button"
				class="btn btn-secondary"
				hx-get={ fmt.Sprintf("/usuarios/%d/editar", u.IDUser) }
				hx-target="closest li"
				hx-swap="outerHTML"
			>Editar</button>
			<button
				type="button"
				class="btn btn-danger"
				hx-delete={ fmt.Sprintf("/usuarios/%d", u.IDUser) }
				hx-target="closest li"
				hx-swap="outerHTML"
				hx-confirm="¿Borrar este usuario? Tambien se borraran todos sus gastos."
			>Borrar</button>
		</div>
	</li>
}

// UserEditItem es el item de un usuario que se renderiza al clickear el boton de edicion, mostrando un form para editar el usuario
templ UserEditItem(f UsuarioFormData) {
	<li class="list-item">
		@UserForm(f)
	</li>
}

// Pagina de usuarios que utiliza la UserList: ahora incluye tambien el formulario arriba para crear usuarios para realizar recarga parcial via HTMX
templ UsersPage(usuarios []db.Usuario, form UsuarioFormData) {
	@Layout("Usuarios") {
		<section class="panel">
			<h1>Crear usuario</h1>
			@UserCreateDivForm(form)
		</section>
		<section class="panel">
			<h1>Usuarios</h1>
			@UserList(usuarios)
		</section>
	}
}

//Div utilizado para envolver al formulario para poder utilizar OOB mas adelante
templ UserCreateDivForm(f UsuarioFormData) {
	<div id="user-form">
		@UserForm(f)
	</div>
}

// Div igual en contenido que UserCreateDivForm pero utilizado con OOB para limpiarse al mismo tiempo cuando se crea un usuario y se realiza recarga parcial de los nuevos usuarios
templ UserCreateDivFormOOB(f UsuarioFormData){
	<div id="user-form" hx-swap-oob="true">
		@UserForm(f)
	</div>
}

// UserForm se utiliza tanto para crear un usuario como para editar un usuario
templ UserForm(f UsuarioFormData) {
	<form
		class="form" 
		method="post" 
		action={ userFormAction(f) }
		if f.ID == 0 {
			hx-post="/usuarios"
			hx-target="#user-list"
			hx-swap="outerHTML"
			hx-target-error="#user-form"
		} else {
			hx-post={ fmt.Sprintf("/usuarios/%d/editar", f.ID) }
			hx-target="closest li"
			hx-swap="outerHTML"
			hx-target-error="closest li"
		}
	>
		if f.Error != "" {
			<p class="alert"> {f.Error}</p>
		}
		<label for={ campoID("username", f.ID) }>Username</label>
		<input id={ campoID("username", f.ID) } name="username" type="text" value={ f.Username } minlength="3" maxlength="25" required/>
		<label for={ campoID("email", f.ID) }>Email</label>
		<input id={ campoID("email", f.ID) } name="email" type="email" value={ f.Email } maxlength="50" required/>
		<div class="form-actions">
			if f.ID == 0 {
				<button type="submit" class="btn">Crear usuario</button>
			} else {
				<button
					type="button"
					class="btn btn-secondary"
					hx-get={ fmt.Sprintf("/usuarios/%d", f.ID) }
					hx-target="closest li"
					hx-swap="outerHTML"
				>Cancelar</button>
				<button type="submit" class="btn">Guardar cambios</button>
			}
		</div>
	</form>
}

// userFormAction devuelve la URL a la que el formulario hace POST:
// /usuarios para crear (ID == 0) o /usuarios/{id}/editar para actualizar.
func userFormAction(f UsuarioFormData) templ.SafeURL {
	if f.ID == 0 {
		return templ.URL("/usuarios")
	}
	return templ.URL(fmt.Sprintf("/usuarios/%d/editar", f.ID))
}
